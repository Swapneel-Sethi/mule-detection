
# Full service account JSON as single-line string

# Optional: token to protect the /api/seed route (set in Vercel + .env.local)
SEED_ROUTE_TOKEN=your_optional_seed_token

# Optional: token to protect the /api/detect route (it mutates Firestore).
# If unset, the route is open — set this in production to require a Bearer token.
DETECT_ROUTE_TOKEN=your_optional_detect_token

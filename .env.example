# Client-side Firebase config (NEXT_PUBLIC_ = safe to expose in browser)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mule-detection-model
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Server-only Firebase Admin SDK (NEVER expose to client)
# Full service account JSON as single-line string
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"mule-detection-model","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@mule-detection-model.iam.gserviceaccount.com"}

# Optional: token to protect the /api/seed route (set in Vercel + .env.local)
SEED_ROUTE_TOKEN=your_optional_seed_token

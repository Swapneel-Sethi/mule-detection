# MuleGuard environment template — copy to .env.local for local dev.
#
# This lists every variable runtime code actually reads (verified by grepping
# process.env / os.environ across src/, backend/ and scripts/). NODE_ENV is
# set automatically by Next.js/the platform — never set it here.
#
# Never commit real values. Datasets ship as public/*.json; the application
# does not depend on an external cloud database provider.

# ---------------------------------------------------------------------------
# Backend API (FastAPI) — see backend/main.py
# ---------------------------------------------------------------------------

# Comma-separated browser origins allowed to call the API. Defaults to
# "http://localhost:3000,http://127.0.0.1:3000" when unset.
MULEGUARD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bind address/port for the backend server (defaults shown).
MULEGUARD_HOST=127.0.0.1
MULEGUARD_PORT=8000

# ---------------------------------------------------------------------------
# Debug helper only (scripts/verify_constellation_tmp.py)
# ---------------------------------------------------------------------------
# Target base URL for the constellation debug script; has a built-in default.
# MULE_GRAPH_BASE_URL=http://127.0.0.1:3235

# NEVER put a private service-account key in this file or any file shipped
# to the client. Secrets belong only in the deployment platform's secret
# store, and must be rotated if they ever touch a repo or client bundle.

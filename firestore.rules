rules_version = '2';

// ============================================================================
// MuleGuard Firestore Security Rules
// ============================================================================
// SECURITY POSTURE: This application accesses Firestore EXCLUSIVELY through
// server-side Next.js API routes using the Firebase Admin SDK. The client-side
// Firebase SDK is NOT used for any database reads/writes.
//
// Therefore, ALL direct client access is denied. This is the same pattern used
// by regulated financial systems: the browser never talks to the DB directly;
// it goes through an authenticated, server-controlled API layer.
//
// If you later add client-side Firestore access (e.g. real-time listeners),
// you MUST add authenticated rules below for ONLY the collections needed,
// scoped to the authenticated user's UID.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny everything by default. Only the Admin SDK (server) bypasses these
    // rules entirely — it has full privileged access regardless of rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
